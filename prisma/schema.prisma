generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // usr_<ulid>
  email     String   @unique
  name      String
  avatarUrl String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResumeProfile {
  id           String   @id // rpf_<ulid>
  slug         String   @unique // e.g. 'vijay-backend'
  displayName  String
  lockedJson   String // JSON-encoded LockedResume
  editableJson String // JSON-encoded EditableResume
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications ResumeApplication[]
}

model ResumeApplication {
  id             String    @id // rap_<ulid>
  profileId      String
  jobTitle       String
  company        String
  jobDescription String // pasted JD text
  originalJson   String // JSON-encoded EditableResume (snapshot at tailoring time)
  tailoredJson   String // JSON-encoded EditableResume (AI output + manual overrides)
  diffSnapshot   String    @default("{}") // per-field accept/reject decisions
  coverLetter    String    @default("") // AI-generated + user-edited cover letter
  status         String    @default("draft") // draft|finalized
  pdfFilename    String?
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile ResumeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([status])
}
