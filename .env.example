# Database — for local dev we use SQLite. Production uses Postgres 16 (see TechSpec §2).
DATABASE_URL="file:./dev.db"

# JWT signing secret — replace in production. See TechSpec §14.
JWT_SECRET="dev-secret-change-me"

# Slack signing secret (Phase 5 — not implemented in this build). See TechSpec §9.5.
SLACK_SIGNING_SECRET=""

# Demo seed user (created by prisma/seed.ts)
SEED_USER_EMAIL="demo@flowboard.app"
SEED_USER_NAME="Demo User"
