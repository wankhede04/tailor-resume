# Database — SQLite for local dev, Postgres for production.
DATABASE_URL="file:./dev.db"

# JWT signing secret — replace in production.
JWT_SECRET="dev-secret-change-me"

# Anthropic API key — required for AI resume tailoring.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Claude model override (optional).
CLAUDE_MODEL="claude-sonnet-4-6"

# Docker Compose image + port overrides (optional).
TAILOR_IMAGE=ghcr.io/wankhede04/tailor-resume:latest
TAILOR_PORT=3000
